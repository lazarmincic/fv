module check_pe_array 
#(  parameter int DATA_WIDTH = 16,
    parameter int LENGTH = 1024
)
(
    input logic clk,
    input logic rst,
    input logic en, 
    input logic sort_dir, 
    input logic shift_left,
    input logic set_reg,
    input logic token_left_i,

    input logic [DATA_WIDTH-1:0] a_left_i,
    input logic [DATA_WIDTH-1:0] b_left_i,

    input logic [DATA_WIDTH-1:0] a_left_o,
    input logic [DATA_WIDTH-1:0] b_left_o,
    input logic token_left_o,

    input logic ain_tvalid,
    input logic ain_tready,
    input logic ain_tlast,
    input logic aout_tready
);

    default clocking @(posedge clk); endclocking
    default disable iff (rst);

    // prethodna vr i tr vr ulaza nisu iste ako je en 1 
    generate
        if (LENGTH/2 > 2) begin
            r1: assume property (en |=> b_left_i != $past(b_left_i)); 
            r2: assume property (en |=> b_left_i != $past(b_left_i)); 
        end
    endgenerate

    // ako je valid 1, sve dok se ne pojavi ready ulazi su isti
    // ekvivalent je shift left 0 - ready, en - valid i ready
    // prethodna vr i tr vr ulaza su iste ako je en 0
    r3: assume property (~en && ~shift_left |=> a_left_i == $past(a_left_i));  
    r4: assume property (~en && ~shift_left |=> b_left_i == $past(b_left_i)); 
    // nakon last a ulaznog
    // jednom kada se pojavi valid, drzi se ulaz dok se ne pojavi ready assume napisi
    assert property (ain_tvalid && ~ain_tready |=> $stable(a_left_i) s_until_with ain_tready);
    assert property (ain_tvalid && ~ain_tready |=> $stable(b_left_i) s_until_with ain_tready);
    //assume property (~ain_tvalid |-> a_left_i == '0); // moze a nije neophodno za axi
    //assume property (~ain_tvalid |-> b_left_i == '0);

    generate
    if (LENGTH/2 > 2) begin
        c1: cover property ((
            set_reg == 1'b1 ##1
            a_left_i == 16'd6 ##0 
            b_left_i == 16'd5 ##0 
            token_left_i ##1 
            a_left_i == 16'd4 ##0 
            b_left_i == 16'd3 ##1 
            a_left_i == 16'd2 ##0 
            b_left_i == 16'd1) intersect ~en ##1 en[*3]); 
    end
    endgenerate

    c2: cover property (token_left_o); 

    // token ne sme da se pojavi kada je en 0
    a1: assert property (~en |-> ~token_left_i);

    // token mora trajati 1 ciklus
    a8: assert property (token_left_i |=> ~token_left_i);

    logic token_cnt;
    always_ff@(posedge clk or posedge rst) begin
        if (rst) begin
            token_cnt <= 1'b0;
        end else begin
            if (en) begin
                if (token_left_i) begin
                    token_cnt <= 1'b1;
                end
            end
        end
    end

    //token sme da se pojavi jednom pri primanju
    a9: assert property (token_left_i |=> token_cnt);

    assert property ($stable(en) && ~en && $stable(shift_left) |-> $stable(a_left_o) );
    assert property ($stable(en) && ~en && $stable(shift_left) |-> $stable(b_left_o));

    assert property (token_left_i |=> ~token_left_i);
    assert property (token_left_o && aout_tready |=> ~token_left_o);
    assert property (token_left_o && ~aout_tready |=> token_left_o);
    // da li radi to sto treba - sortira
    // te provere su u check dup cnt
    
    // token left i se pojavljuje kada i prvi validan podatak
    // to je kada su en 1 i shift left 0 PRVI PUT
    bit first_valid;
    always_ff@(posedge clk or posedge rst) begin
        if (rst) begin
            first_valid <= 1'b0;
        end else begin
            if (en && ~shift_left) begin
                first_valid <= 1'b1;
            end
            if (shift_left) begin
                first_valid <= 1'b0;
            end
        end
    end
    assert property ((~first_valid && en && ~shift_left) == token_left_i);

    //token left o mora da se desi kada i poslednji prenos
    bit poslednji_pr;
    bit [$clog2(LENGTH)-1:0] pren_c;
    always_ff@(posedge clk or posedge rst) begin
        if (rst) begin
            pren_c <= '0;
        end else if (~shift_left) begin
            pren_c <= '0;
        end else begin
            if (en && shift_left) begin
                pren_c <= pren_c + 1'b1;
            end
        end
    end
    assign poslednji_pr = pren_c == '1 ? 1'b1 : 1'b1;

    assert property (token_left_o |=> poslednji_pr);

endmodule