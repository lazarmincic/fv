module check_pe 
    #(
		parameter int DATA_WIDTH = 16,
		parameter int LENGTH = 1024
	)
(    
    input logic clk,
    input logic rst,
    input logic en,
    input logic set_reg,
    input logic shift_left,
    input logic sort_dir,

    input logic token_left_i,

    input logic token_right_o,
    input logic [DATA_WIDTH-1:0] a_left_i,
    input logic [DATA_WIDTH-1:0] b_left_i,
    
    input logic [DATA_WIDTH-1:0] a_right_o,
    input logic [DATA_WIDTH-1:0] b_right_o,
    input logic [DATA_WIDTH-1:0] reg_a,
    input logic [DATA_WIDTH-1:0] reg_b,
    input logic [DATA_WIDTH-1:0] a_left_o,
    input logic [DATA_WIDTH-1:0] b_left_o,
    input logic token_right_i,
    input logic token_left_o,
    input logic [DATA_WIDTH-1:0] a_right_i,
    input logic [DATA_WIDTH-1:0] b_right_i
);

    default clocking @(posedge clk); endclocking
    default disable iff (rst);

    logic token_cnt;
    logic en_cnt;
    always_ff@(posedge clk or posedge rst) begin
        if (rst) begin
            token_cnt <= 1'b0;
            en_cnt <= 1'b0;
        end else begin
            if (en) begin
                if (token_left_i) begin
                    token_cnt <= 1'b1;
                end
                if (!shift_left) begin
                    en_cnt <= 1'b1;
                end
                if (shift_left) begin
                    token_cnt <= 1'b0;
                end
            end
        end
    end


    // ulazi ograniceni parametrom

    c2: cover property (1[*10]);

    // token se ne moze pojaviti ukoliko se vrsi pom u levo - TODO
    a10: assert property (shift_left |-> ~token_left_i); // 
    // token se "prenosi" sa levog ulaza na desni izlaz
    // token left i uvek se pojavljuje nakon set reg
    //r1: assume property (1);
    a11: assert property (token_left_i && ~shift_left && en |=> token_right_o); 
    // Vacuous Pass za poslednji modul u lancu u slucaju da je koriscen operator |=>
    a12: assert property (!(token_right_i && shift_left && en) or ((token_right_i && shift_left && en) ##1 token_left_o));
    //a26: assert property ((je_poslednji && ~token_right_i) || (~je_poslednji));
    // token right o traje 1 ciklus ukoliko je en aktivan
    a13: assert property (token_right_o ##0 en |=> ~token_right_o);
    // token sme da se pojavi samo jednom za vreme prenosa u desno
    a14: assert property (token_left_i |-> ~token_cnt); 
    // token ne sme da se pojavi prilikom prenosa u levo
    assert property (shift_left |-> ~token_left_i);

    a15: assert property (en && ~en_cnt && sort_dir |-> a_right_o == b_right_o && a_right_o == '1); 
    a16: assert property (en && ~en_cnt && ~sort_dir  |-> a_right_o == b_right_o && a_right_o == '0);

    a18: assert property ((set_reg) |=> (reg_a == '1 && reg_b == '1)); 

    a19: assert property (sort_dir && en && ~shift_left |-> (a_right_o <= b_right_o && reg_a <= reg_b && reg_a <= a_right_o));
    a20: assert property (~sort_dir && en && ~shift_left |-> (a_right_o >= b_right_o && reg_a >= reg_b && reg_a >= a_right_o) 
                                          || (~en_cnt && (a_right_o == b_right_o && a_right_o == '0)));

    a21: assert property (shift_left |-> a_left_o == reg_a);
    a22: assert property (shift_left |-> b_left_o == reg_b);
    // ukoliko je shift left visok, vrsi se pomeranje levo
    a23: assert property (shift_left && en |=> reg_a == $past(a_right_i));
    a24: assert property (shift_left && en |=> reg_b == $past(b_right_i));
    a25: assert property (shift_left |-> reg_a == a_left_o && reg_b == b_left_o);

endmodule