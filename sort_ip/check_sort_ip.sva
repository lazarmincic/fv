module check_sort_ip 
  #(
		parameter int DATA_WIDTH = 16,
		parameter int LENGTH = 1024
	)
  (
    input logic clk,
    input logic rst,

    input logic en,
    input logic shift_left,
    input logic set_reg,

    input logic sort_dir,
    input logic ain_tvalid,
    input logic [DATA_WIDTH*2-1:0] ain_tdata,
    input logic ain_tlast,
    input logic aout_tready,

    input logic ain_tready,
    input logic [$clog2(LENGTH)-1:0] dup_nums,
    input logic aout_tvalid,
    
    input logic [DATA_WIDTH*2-1:0] aout_tdata,
    input logic aout_tlast
  );

    default clocking @(posedge clk); endclocking
    default disable iff (rst);

    // axi interfejs
    // sort dir prati valid
    // assume property (ain_tvalid [->2] |-> );
    // ogranici opseg ulaza
    //assume property (ain_tdata >= 0 && ain_tdata <= 1023);
    // dok se ne desi handshake valid data last i sort dir ostaju isti
    //assume property (ain_tvalid ##0 ~ain_tready ##1 ~ain_tready |-> ain_tdata[*2] );

/*
    logic [9:0] data_t; // 10 bitova jer je ogr. ulaz na do 1023 broja
    logic [10:0] cnt1; // broji preklapanja valid i ready
    always_ff @(posedge clk or posedge rst) begin
      if (rst) begin
        data_t <= '0;
        cnt1 <= '0;
      end else begin
        data_t <= ain_tdata; // pamti proslu vr
        if (ain_tvalid && ain_tready) begin
          cnt1 <= cnt1 + 1'b1;
        end
      end
    end
*/

    /*
    assume property (ain_tvalid ##0 ~ain_tready ##1 ain_tready |=> ain_tdata != data_t);
    assume property (ain_tvalid ##0 ain_tready |-> ain_tdata != data_t );
    assume property (ain_tvalid ##0 ~ain_tready |=> ain_tdata == data_t);//
    assume property (ain_tvalid ##0 ain_tready ##0 cnt1 == 1024 |-> ain_tlast);
    //assume property (ain_tvalid[*1:$] |=> ain_tready); // ne valja
    

    assert property (ain_tvalid |=> ain_tready);

    cover property (aout_tvalid);//
    */

    // set reg mora uvek da se desi pre ready (i) ja
    // clear uvek mora da se desi pre valida (o)
    // fsm nikada ne sme da je u stanju 11

    // mora se dodati assume na mestima gde su iseceni registri
    // blackbox with holes

//========================================================================================================
    // pe:

    logic en_cnt; // 1 nakon reseta
    logic sort_dir_first;
    bit set_reg_c;
    bit is_last_cnt;
    always_ff@(posedge clk or posedge rst) begin
        if (rst) begin
            en_cnt <= 1'b0;
            sort_dir_first <= 1'b0;
            set_reg_c <= 1'b0;
            is_last_cnt <= 1'b0;
        end
        else begin
            if (en) begin
                if (!shift_left) begin
                    en_cnt <= 1'b1;
                end
                if (!en_cnt) begin
                    sort_dir_first <= sort_dir;
                end
            end
            if (set_reg)
                set_reg_c <= 1'b1;
            if (ain_tvalid && ain_tready && ain_tlast)
                is_last_cnt <= 1'b1;
        end
    end

    

    assert property (en && ~en_cnt && sort_dir ##1 1 |=> always $stable(sort_dir_first));
    assert property (en && ~en_cnt && sort_dir |=> sort_dir_first == $past(sort_dir));
    assert property (en && ~en_cnt && ~sort_dir ##1 1 |=> always $stable(sort_dir_first));
    assert property (en && ~en_cnt && ~sort_dir |=> sort_dir_first == $past(sort_dir));

    // en mora biti uvek 1 za svaki shift_left
    assert property (en && aout_tvalid |-> shift_left);
    assert property (~aout_tvalid |-> ~shift_left);
    // shift left se ne menja dok je prijem u toku i 0 je
    assert property (ain_tready |-> ~shift_left); 
    // shift left je 1 dok se salje
    assert property (aout_tvalid && aout_tready |-> shift_left);
    // shift left moze da se aktivira jedino nakon sto pe primi sve brojeve
    assert property (~is_last_cnt |-> ~shift_left); 
    
    // set reg mora trajati 1 ciklus
    a15: assert property (set_reg |=> ~set_reg);
    // set reg ne sme da se pojavi kada je en 0
    a16: assert property (en |-> ~set_reg);
    assert property (set_reg |-> ~en);
    // set reg se pojavljuje jednom, pre prvog en, kada i prvi valid
    a17: assert property ((sort_dir && en && ~en_cnt |-> set_reg_c) or (~sort_dir && en && ~en_cnt |-> ~set_reg_c));
    assert property (set_reg |=> set_reg_c);
    assert property (set_reg_c |=> $stable(set_reg_c));
    a25: assert property ((en |=> en_cnt));
    // ogranici shift left
    // en ne sme da se desi pre set reg, ukoliko je sort dir 1
    //assume property (1);
    c21: cover property (set_reg and 1'b1[*5]);

    //=====================================================================================================
    // fsm:

    c1: cover property (aout_tlast); 

    cover property (~ain_tvalid ##1 ain_tvalid ##1 ~ain_tvalid);
    
    
      
endmodule
